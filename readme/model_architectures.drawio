                <mxCell id="ema-eval" value="validation / eval&#xa;optionally use ema_model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13" parent="1" vertex="1">
                    <mxGeometry x="350" y="370" width="190" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="ema-note" value="ModelEMA is not a prediction architecture. It keeps a smoother copy of model weights during training." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" parent="1" vertex="1">
                    <mxGeometry x="80" y="520" width="360" height="90" as="geometry"/>
