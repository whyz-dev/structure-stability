    <diagram id="model-ema" name="ModelEMA">
        <mxGraphModel dx="1164" dy="861" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
            <root>
