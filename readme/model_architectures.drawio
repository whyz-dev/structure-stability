                    <mxGeometry x="80" y="150" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ema-model" value="train model&#xa;backprop + optimizer.step()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="320" y="130" width="220" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ema-update" value="ema.update(model)&#xa;floating params:&#xa;ema = decay * ema + (1-decay) * model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" parent="1" vertex="1">
                    <mxGeometry x="640" y="120" width="250" height="120" as="geometry"/>
